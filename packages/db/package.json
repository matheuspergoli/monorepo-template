{
	"name": "@repo/db",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#src/*": "./src/*.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./schema": "./src/schema.ts"
	},
	"license": "MIT",
	"scripts": {
		"clean": "rm -rf .cache .turbo .typescript dist",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:reset": "rm -rf .cache db.sqlite ./src/migrations && pnpm db:push"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3",
		"drizzle-orm": "^0.45.2",
		"ioredis": "^5.10.1",
		"unstorage": "^1.17.5"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/bun": "^1.3.13",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3"
	}
}
