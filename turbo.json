{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"concurrency": "20",
	"globalEnv": ["NODE_ENV", "VITE_BACKEND_URL", "VITE_AUTH_ISSUER_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**", ".typescript/tsbuildinfo.json"]
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		},
		"ui-add": {
			"cache": false,
			"interactive": true
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": [".typescript/tsbuildinfo.json"]
		},
		"db:push": {
			"cache": false
		},
		"db:reset": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false
		}
	}
}
